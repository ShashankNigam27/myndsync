# =====================================================================
# MyndSync Root .gitignore
# =====================================================================

# Environment variables & secrets (NEVER commit secrets)
.env
.env.*
backend/.env
backend/.env.*
!.env.example
!backend/.env.example

# Python & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Database files (SQLite)
*.db
*.sqlite
*.sqlite3
myndsync.db
backend/myndsync.db

# Ensure Alembic migration files are ALWAYS tracked and committed
!backend/alembic/versions/*.py
!alembic/versions/*.py

# IDE, Editor & OS junk
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Testing, Cache & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Logs
*.log
